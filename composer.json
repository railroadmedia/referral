{
  "name": "railroad/referral",
  "type": "library",
  "description": "Musora referral package",
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "railroad/usora": "4.0.*",
    "railroad/ecommerce": "6.0.*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\Referral\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Referral\\Tests\\": "tests/"
    }
  }
}
